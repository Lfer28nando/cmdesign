<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - CmDesign</title>
    <link rel="stylesheet" href="/css/output.css">
</head>

<body class="h-screen overflow-hidden bg-neutral-900">
    <script type="module" src="/js/api.functions.js"></script>
    <script type="module" src="/js/googleAuth.functions.js"></script>
    <script type="module" src="/js/login.functions.js"></script>

    <!-- NAVBAR (DESKTOP) -->
    <nav class="hidden lg:flex sticky top-0 z-50 bg-white shadow-[0_6px_18px_rgba(0,0,0,0.08)]">
        <div class="w-full flex items-center justify-between px-4 py-4">
            <!-- Logo izquierda -->
            <div class="flex-1">
                <a href="/"><img src="/img/logo_cmdesign_iso.svg" alt="CmDesign" class="h-11"></a>
            </div>

            <!-- Secciones centradas -->
            <ul class="flex items-center">
                <li class="text-center mx-2.5">
                    <a href="/"
                        class="block text-sm uppercase font-medium text-slate-700 hover:text-green-500 transition pb-1.5 relative group">
                        <span>Camisetas</span>
                        <small class="block text-[0.65rem] opacity-70 normal-case">Todas las tallas</small>
                        <span
                            class="absolute left-0 bottom-0 h-0.5 w-0 bg-green-500 transition-all duration-300 group-hover:w-full"></span>
                    </a>
                </li>
                <li class="text-center mx-2.5">
                    <a href="/catalogo"
                        class="block text-sm uppercase font-medium text-slate-700 hover:text-green-500 transition pb-1.5 relative group">
                        <span>Buzos</span>
                        <small class="block text-[0.65rem] opacity-70 normal-case">y hoodies</small>
                        <span
                            class="absolute left-0 bottom-0 h-0.5 w-0 bg-green-500 transition-all duration-300 group-hover:w-full"></span>
                    </a>
                </li>
                <li class="text-center mx-2.5">
                    <a href="/servicios"
                        class="block text-sm uppercase font-medium text-slate-700 hover:text-green-500 transition pb-1.5 relative group">
                        <span>Nuevos</span>
                        <small class="block text-[0.65rem] opacity-70 normal-case">Lanzamientos</small>
                        <span
                            class="absolute left-0 bottom-0 h-0.5 w-0 bg-green-500 transition-all duration-300 group-hover:w-full"></span>
                    </a>
                </li>
                <li class="text-center mx-2.5">
                    <a href="/blog"
                        class="block text-sm uppercase font-medium text-slate-700 hover:text-green-500 transition pb-1.5 relative group">
                        <span>Descuentos</span>
                        <small class="block text-[0.65rem] opacity-70 normal-case">Hasta 60% off</small>
                        <span
                            class="absolute left-0 bottom-0 h-0.5 w-0 bg-green-500 transition-all duration-300 group-hover:w-full"></span>
                    </a>
                </li>
                <li class="text-center mx-2.5">
                    <a href="/contacto"
                        class="block text-sm uppercase font-medium text-slate-700 hover:text-green-500 transition pb-1.5 relative group">
                        <span>Contacto</span>
                        <small class="block text-[0.65rem] opacity-70 normal-case">Tiendas</small>
                        <span
                            class="absolute left-0 bottom-0 h-0.5 w-0 bg-green-500 transition-all duration-300 group-hover:w-full"></span>
                    </a>
                </li>
            </ul>

            <!-- Iconos derecha -->
            <div class="flex flex-1 items-center justify-end gap-3">
                <!-- Buscar -->
                <button id="btnSearchOpen" type="button" aria-label="Buscar"
                    class="p-2 text-slate-700 hover:text-green-500 transition">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8" />
                        <path d="m21 21-4.34-4.34" />
                    </svg>
                </button>

                <!-- Carrito -->
                <a href="/carrito" class="relative p-2 text-slate-700 hover:text-green-500 transition">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 10a4 4 0 0 1-8 0" />
                        <path d="M3.103 6.034h17.794" />
                        <path
                            d="M3.4 5.467a2 2 0 0 0-.4 1.2V20a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6.667a2 2 0 0 0-.4-1.2l-2-2.667A2 2 0 0 0 17 2H7a2 2 0 0 0-1.6.8z" />
                    </svg>
                    <span id="cartCount"
                        class="absolute -top-1 -right-1 hidden h-5 w-5 items-center justify-center rounded-full bg-red-500 text-xs text-white">0</span>
                </a>

                <!-- Perfil -->
                <button id="btnPerfil" type="button" class="hidden p-2 text-slate-700 hover:text-green-500 transition">
                    <img src="/img/icon-user.svg" alt="Perfil" class="h-5 w-5">
                </button>
            </div>
        </div>
    </nav>

    <!-- Modal de Busqueda Desktop -->
    <div id="searchModal"
        class="fixed inset-x-0 top-0 z-1055 -translate-y-full bg-white shadow-lg transition-transform duration-300">
        <div class="w-full px-4 py-4">
            <div class="flex items-center gap-3">
                <form class="flex-1" role="search" action="/buscar" method="GET">
                    <div class="flex items-center rounded-lg border border-neutral-300 bg-white">
                        <span class="px-4 text-neutral-500">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8" />
                                <path d="m21 21-4.34-4.34" />
                            </svg>
                        </span>
                        <input id="searchInput" type="search" name="q" placeholder="Buscar productos..."
                            class="flex-1 bg-transparent py-3 pr-4 text-lg text-neutral-800 placeholder-neutral-400 focus:outline-none">
                    </div>
                </form>
                <button id="btnSearchClose" type="button"
                    class="rounded-lg border border-neutral-300 p-3 text-neutral-600 hover:bg-neutral-100">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 6 6 18" />
                        <path d="m6 6 12 12" />
                    </svg>
                </button>
            </div>
        </div>
    </div>

    <!-- Overlay busqueda -->
    <div id="searchOverlay"
        class="fixed inset-0 z-1054 bg-black/50 opacity-0 invisible transition-opacity duration-300"></div>

    <script type="module" src="/js/navbar.js"></script>
    <script type="module" src="/js/cart.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const btnOpen = document.getElementById('btnSearchOpen');
            const btnClose = document.getElementById('btnSearchClose');
            const modal = document.getElementById('searchModal');
            const overlay = document.getElementById('searchOverlay');
            const searchInput = document.getElementById('searchInput');

            function openSearch() {
                modal.classList.remove('-translate-y-full');
                modal.classList.add('translate-y-0');
                overlay.classList.remove('opacity-0', 'invisible');
                overlay.classList.add('opacity-100', 'visible');
                document.body.style.overflow = 'hidden';
                setTimeout(() => searchInput.focus(), 300);
            }

            function closeSearch() {
                modal.classList.add('-translate-y-full');
                modal.classList.remove('translate-y-0');
                overlay.classList.add('opacity-0', 'invisible');
                overlay.classList.remove('opacity-100', 'visible');
                document.body.style.overflow = '';
            }

            if (btnOpen) btnOpen.addEventListener('click', openSearch);
            if (btnClose) btnClose.addEventListener('click', closeSearch);
            if (overlay) overlay.addEventListener('click', closeSearch);
            document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeSearch(); });
        });
    </script>

    <!-- Background blur -->
    <div class="fixed inset-0 z-0 bg-cover bg-center brightness-95 opacity-50 scale-110"
        style="background-image: url('/img/login.webp');">
    </div>

    <!-- Main Container -->
    <div class="relative z-10 flex h-[calc(100vh-72px)] items-center justify-center p-4">
        <div class="w-full max-w-5xl overflow-hidden rounded-2xl shadow-2xl lg:flex lg:h-[75vh] lg:min-h-[500px]">

            <!-- Left Panel - Image (Desktop only) -->
            <div class="hidden lg:flex lg:w-1/2 relative bg-cover bg-bottom"
                style="background-image: url('/img/login.webp');">
                <div class="flex h-full w-full flex-col items-center justify-end p-6">
                    <div class="w-full max-w-sm rounded-xl bg-black/85 px-4 py-3 text-center">
                        <h2 class="mb-2 text-xl font-bold text-gray-100">Te extrañamos!</h2>
                        <p class="mb-3 text-sm text-gray-100">
                            Bienvenido de nuevo, accede para continuar disfrutando de nuestra comunidad.
                        </p>
                        <p class="mb-2 text-sm font-bold text-gray-100">¿No tienes una cuenta?</p>
                        <a href="/register"
                            class="inline-flex items-center gap-2 rounded-lg bg-neutral-800 px-4 py-2 text-sm font-bold text-white transition hover:bg-neutral-700 border border-neutral-600">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                stroke-linejoin="round">
                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                                <circle cx="9" cy="7" r="4" />
                                <line x1="19" x2="19" y1="8" y2="14" />
                                <line x1="22" x2="16" y1="11" y2="11" />
                            </svg>
                            Registrarse
                        </a>
                    </div>
                </div>
            </div>

            <!-- Right Panel - Form -->
            <div class="flex w-full flex-col bg-neutral-900 p-8 lg:w-1/2 lg:p-12">
                <div class="w-full max-w-sm mx-auto">
                    <!-- Botón regresar (Mobile/Tablet) -->
                    <div class="mb-4 lg:hidden">
                        <a href="/" class="inline-flex items-center gap-2 text-gray-400 hover:text-white transition">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                                stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="m15 18-6-6 6-6"/>
                            </svg>
                            <span class="text-sm">Regresar</span>
                        </a>
                    </div>

                    <!-- Logo (Mobile) -->
                    <div class="mb-6 text-center lg:hidden">
                        <a href="/">
                            <img src="/img/logo_cmdesign_white.svg" alt="CmDesign" class="mx-auto h-12">
                        </a>
                    </div>

                    <h1 class="mb-2 text-3xl font-bold text-white">Iniciar Sesión</h1>
                    <p class="mb-6 text-gray-400">Ingresa tus datos para acceder a CmDesign</p>

                    <form id="loginForm" autocomplete="on" method="POST" action="/login" class="space-y-4">
                        <!-- Email -->
                        <div>
                            <label for="email" class="mb-1 block text-sm text-gray-300">Correo Electrónico</label>
                            <input type="email" id="email" name="email" required autocomplete="email"
                                placeholder="tu@ejemplo.com"
                                class="w-full rounded-lg border border-neutral-700 bg-neutral-800 px-4 py-2.5 text-white placeholder-gray-500 focus:border-white focus:outline-none focus:ring-1 focus:ring-white">
                        </div>

                        <!-- Password -->
                        <div>
                            <label for="password" class="mb-1 block text-sm text-gray-300">Contraseña</label>
                            <input type="password" id="password" name="password" required
                                autocomplete="current-password" placeholder="Ingresa tu contraseña"
                                class="w-full rounded-lg border border-neutral-700 bg-neutral-800 px-4 py-2.5 text-white placeholder-gray-500 focus:border-white focus:outline-none focus:ring-1 focus:ring-white">
                        </div>

                        <!-- Forgot Password -->
                        <div class="text-right">
                            <a href="/recuperar" class="text-sm text-gray-400 hover:text-white transition">
                                ¿Olvidaste tu contraseña?
                            </a>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit"
                            class="flex w-full items-center justify-center gap-2 rounded-lg bg-white py-2.5 font-bold text-neutral-900 transition hover:bg-gray-200">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                stroke-linejoin="round">
                                <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                                <circle cx="12" cy="7" r="4" />
                            </svg>
                            Iniciar Sesión
                        </button>

                        <!-- Divider -->
                        <div class="flex items-center gap-3">
                            <div class="h-px flex-1 bg-neutral-700"></div>
                            <span class="text-sm text-gray-500">o continúa con</span>
                            <div class="h-px flex-1 bg-neutral-700"></div>
                        </div>

                        <!-- Google Button -->
                        <button type="button" id="googleAuth"
                            class="flex w-full items-center justify-center gap-2 rounded-lg border border-neutral-600 bg-white py-2.5 font-medium text-gray-700 transition hover:bg-gray-100">
                            <img src="https://upload.wikimedia.org/wikipedia/commons/c/c1/Google_%22G%22_logo.svg"
                                alt="Google" width="20" height="20">
                            Continuar con Google
                        </button>
                    </form>

                    <!-- Register Link -->
                    <p class="mt-6 text-center text-sm text-gray-400">
                        ¿No tienes cuenta?
                        <a href="/register" class="font-bold text-white hover:text-gray-300 transition">Regístrate</a>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <!-- 2FA Modal -->
    <div id="twoFAModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50">
        <div class="w-full max-w-md rounded-xl bg-neutral-900 p-6 text-white">
            <div class="mb-4 flex items-center justify-between border-b border-neutral-700 pb-4">
                <h5 class="text-lg font-bold">Verificación de Dos Factores</h5>
                <button type="button" onclick="closeTwoFAModal()" class="text-gray-400 hover:text-white">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 6 6 18" />
                        <path d="m6 6 12 12" />
                    </svg>
                </button>
            </div>
            <div class="mb-4 text-center">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                    class="mx-auto mb-3 text-white">
                    <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                </svg>
                <p class="text-gray-300">Ingresa el código de 6 dígitos de tu aplicación autenticadora</p>
            </div>
            <div class="mb-4">
                <label for="twoFACode" class="mb-1 block text-sm text-gray-300">Código 2FA</label>
                <input type="text" id="twoFACode" maxlength="6" placeholder="000000"
                    class="w-full rounded-lg border border-neutral-600 bg-neutral-800 px-4 py-3 text-center text-xl tracking-widest text-white placeholder-gray-500 focus:border-white focus:outline-none">
            </div>
            <p class="mb-4 text-center text-sm text-gray-400">
                ¿No tienes acceso a tu código?
                <a href="/recuperar" class="text-white hover:text-gray-300 transition">Recupera tu cuenta</a>
            </p>
            <div class="flex gap-3">
                <button type="button" onclick="closeTwoFAModal()"
                    class="flex-1 rounded-lg border border-neutral-600 py-2.5 text-white transition hover:bg-neutral-800">
                    Cancelar
                </button>
                <button type="button" onclick="verify2FA()"
                    class="flex-1 rounded-lg bg-white py-2.5 font-bold text-neutral-900 transition hover:bg-gray-200">
                    Verificar
                </button>
            </div>
        </div>
    </div>

    <script>
        function closeTwoFAModal() {
            document.getElementById('twoFAModal').classList.add('hidden');
            document.getElementById('twoFAModal').classList.remove('flex');
        }

        function openTwoFAModal() {
            document.getElementById('twoFAModal').classList.remove('hidden');
            document.getElementById('twoFAModal').classList.add('flex');
        }
    </script>
</body>

</html>