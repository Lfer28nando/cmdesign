            <button data-sort="descuento">Mayor descuento</button>
            <button data-sort="precioBase">Menor precio</button>
            <button data-sort="-precioBase">Mayor precio</button>
            <button data-sort="nombre">Nombre A-Z</button>
            <button data-sort="-nombre">Nombre Z-A</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Grid de productos -->
    <div class="cm-products-grid" id="cmProductsGrid" data-cols="5">
      <!-- Los productos se cargan dinamicamente -->
      <div class="cm-loading">
        <div class="cm-spinner"></div>
        <p>Cargando productos...</p>
      </div>
    </div>

    <!-- Barra de progreso y ver más -->
    <div class="cm-load-more-section">
      <div class="cm-progress-bar">
        <div class="cm-progress-fill" id="cmProgressFill" style="width: 0%"></div>
      </div>
      <p class="cm-progress-text">Mostrando <span id="cmShownCount">0</span> de <span id="cmTotalCount">0</span> productos</p>
      <button class="cm-load-more-btn" id="cmLoadMoreBtn">VER MÁS</button>
    </div>

  </div>
</section>
