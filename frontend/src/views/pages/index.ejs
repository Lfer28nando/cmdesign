<!-- Botón flotante Panel Admin (solo visible para admin, se muestra por JS) -->
<div id="adminPanelFab" style="display:none; position:fixed; bottom:32px; right:32px; z-index:9999;">
  <a href="/admin" class="btn btn-danger btn-lg shadow-lg d-flex align-items-center gap-2" style="font-size:1.25rem; border-radius:50px; padding:18px 32px 18px 28px; box-shadow:0 4px 24px rgba(0,0,0,0.18);">
    <i class="fas fa-tools fa-lg me-2"></i>Panel Admin
  </a>
</div>
<script type="module">
import { API } from '/js/api.functions.js';
(async () => {
  try {
    const res = await API.get('/auth/me', { withCredentials: true });
    if (res?.data?.ok && res.data.user?.role === 'admin') {
      document.getElementById('adminPanelFab').style.display = 'block';
    } else {
      // fallback
      const res2 = await API.get('/api/auth/profile', { withCredentials: true });
      if (res2?.data?.success && res2.data.user?.role === 'admin') {
        document.getElementById('adminPanelFab').style.display = 'block';
      }
    }
  } catch {}
})();
</script>

