        <div class="w-full max-w-5xl overflow-hidden rounded-2xl shadow-2xl lg:flex lg:h-[80vh] lg:min-h-[550px]">

            <!-- Left Panel - Form -->
            <div class="flex w-full flex-col bg-neutral-900 p-8 lg:w-1/2 lg:p-12 overflow-y-auto max-h-[80vh] lg:max-h-none scrollbar-custom">
                <div class="w-full max-w-sm mx-auto">
                    <!-- Boton regresar (Mobile/Tablet) -->
