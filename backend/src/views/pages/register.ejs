                        <h2 class="mb-2 text-xl font-bold text-gray-100">Bienvenido a CmDesign</h2>
                        <p class="mb-3 text-sm text-gray-100">
                            Unete a nuestra comunidad y descubre las mejores prendas urbanas.
                        </p>
                        <p class="mb-2 text-sm font-bold text-gray-100">Ya tienes una cuenta?</p>
                        <a href="/login"
                            class="inline-flex items-center gap-2 rounded-lg bg-neutral-800 px-4 py-2 text-sm font-bold text-white transition hover:bg-neutral-700 border border-neutral-600">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                stroke-linejoin="round">
                                <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                                <circle cx="12" cy="7" r="4" />
                            </svg>
                            Iniciar Sesion
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Guest Guard -->
