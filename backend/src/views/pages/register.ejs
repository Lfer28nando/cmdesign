                    <h1 class="mb-2 text-3xl font-bold text-white">Crear Cuenta</h1>
                    <p class="mb-6 text-gray-400">Unete a CmDesign y comienza tu experiencia</p>

                    <form id="registerForm" autocomplete="on" class="space-y-4">
                        <!-- Username -->
                        <div>
                            <label for="username" class="mb-1 block text-sm text-gray-300">Nombre de Usuario</label>
                            <input type="text" id="username" name="username" required
                                placeholder="Ingresa tu nombre de usuario"
                                class="w-full rounded-lg border border-neutral-700 bg-neutral-800 px-4 py-2.5 text-white placeholder-gray-500 focus:border-white focus:outline-none focus:ring-1 focus:ring-white">
                        </div>

                        <!-- Phone -->
                        <div>
                            <label for="cellphone" class="mb-1 block text-sm text-gray-300">Telefono (Opcional)</label>
                            <input type="tel" id="cellphone" name="cellphone"
                                placeholder="(+57) 300 123 4567"
                                class="w-full rounded-lg border border-neutral-700 bg-neutral-800 px-4 py-2.5 text-white placeholder-gray-500 focus:border-white focus:outline-none focus:ring-1 focus:ring-white">
                        </div>

                        <!-- Email -->
                        <div>
                            <label for="email" class="mb-1 block text-sm text-gray-300">Correo Electronico</label>
                            <input type="email" id="email" name="email" required autocomplete="email"
                                placeholder="tu@ejemplo.com"
                                class="w-full rounded-lg border border-neutral-700 bg-neutral-800 px-4 py-2.5 text-white placeholder-gray-500 focus:border-white focus:outline-none focus:ring-1 focus:ring-white">
                        </div>

                        <!-- Password -->
                        <div>
                            <label for="password" class="mb-1 block text-sm text-gray-300">Contrasena</label>
                            <input type="password" id="password" name="password" required
                                autocomplete="new-password" placeholder="Minimo 6 caracteres"
                                class="w-full rounded-lg border border-neutral-700 bg-neutral-800 px-4 py-2.5 text-white placeholder-gray-500 focus:border-white focus:outline-none focus:ring-1 focus:ring-white">
                            <p id="passwordFeedback" class="mt-1 text-xs text-gray-500">
                                Recomendamos usar al menos 8 caracteres con mayusculas, numeros y simbolos.
                            </p>
                        </div>

                        <!-- Confirm Password -->
                        <div>
                            <label for="confirmPassword" class="mb-1 block text-sm text-gray-300">Confirmar Contrasena</label>
                            <input type="password" id="confirmPassword" name="confirmPassword" required
                                autocomplete="new-password" placeholder="Confirma tu contrasena"
                                class="w-full rounded-lg border border-neutral-700 bg-neutral-800 px-4 py-2.5 text-white placeholder-gray-500 focus:border-white focus:outline-none focus:ring-1 focus:ring-white">
                        </div>

                        <!-- Terms -->
                        <div class="flex items-start gap-2">
                            <input type="checkbox" id="acceptTerms" name="acceptTerms" required
                                class="mt-1 h-4 w-4 rounded border-neutral-600 bg-neutral-800 text-white focus:ring-white focus:ring-offset-neutral-900">
                            <label for="acceptTerms" class="text-sm text-gray-400">
                                Acepto las <a href="#" class="text-white hover:text-gray-300 transition">politicas de privacidad</a> y
                                <a href="#" class="text-white hover:text-gray-300 transition">terminos de servicio</a> de CmDesign.
                            </label>
                        </div>

                        <!-- Submit Button -->
                        <button type="submit"
                            class="flex w-full items-center justify-center gap-2 rounded-lg bg-white py-2.5 font-bold text-neutral-900 transition hover:bg-gray-200">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                stroke-linejoin="round">
                                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                                <circle cx="9" cy="7" r="4" />
                                <line x1="19" x2="19" y1="8" y2="14" />
                                <line x1="22" x2="16" y1="11" y2="11" />
                            </svg>
                            Crear Cuenta
                        </button>

                        <!-- Divider -->
                        <div class="flex items-center gap-3">
                            <div class="h-px flex-1 bg-neutral-700"></div>
                            <span class="text-sm text-gray-500">o continua con</span>
                            <div class="h-px flex-1 bg-neutral-700"></div>
                        </div>

                        <!-- Google Button -->
                        <button type="button" id="googleAuth"
                            class="flex w-full items-center justify-center gap-2 rounded-lg border border-neutral-600 bg-white py-2.5 font-medium text-gray-700 transition hover:bg-gray-100">
                            <img src="https://upload.wikimedia.org/wikipedia/commons/c/c1/Google_%22G%22_logo.svg"
                                alt="Google" width="20" height="20">
                            Continuar con Google
                        </button>
                    </form>

                    <!-- Login Link -->
                    <p class="mt-6 text-center text-sm text-gray-400">
                        Ya tienes cuenta?
