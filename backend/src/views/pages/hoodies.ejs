<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/index.styles.css">
<link rel="stylesheet" href="/css/configurable-page.css">

<main class="cm-configurable-page" data-slug="hoodies">
  <!-- Header de la página -->
  <div class="cm-page-header">
    <div class="container">
      <h1 class="cm-page-title" id="pageTitle">Buzos y Hoodies</h1>
      <p class="cm-page-description" id="pageDescription">Encuentra el buzo perfecto para ti</p>
    </div>
  </div>
  
  <!-- Botón de modo edición (solo admin) -->
  <div id="adminEditControls" class="cm-admin-controls" style="display: none;">
    <button id="btnToggleEdit" class="cm-admin-btn">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
      </svg>
      <span>Modo Edición</span>
    </button>
  </div>
  
  <!-- Grid de cards dinámicas -->
  <div class="cm-cards-container">
    <div class="cm-cards-grid" id="cardsGrid" data-count="3">
      <!-- Cards se cargan dinámicamente -->
      <div class="cm-loading">
        <div class="cm-spinner"></div>
        <p>Cargando...</p>
      </div>
    </div>
  </div>
  
  <!-- Botón añadir card (solo en modo edición) -->
  <div id="addCardContainer" class="cm-add-card-container" style="display: none;">
    <button id="btnAddCard" class="cm-add-card-btn">
      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="12" y1="5" x2="12" y2="19"/>
        <line x1="5" y1="12" x2="19" y2="12"/>
      </svg>
      <span>Añadir nueva card</span>
    </button>
  </div>
  
  <!-- Link volver -->
  <a href="/" class="cm-back-link" style="margin-top: 40px;">
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M19 12H5M12 19l-7-7 7-7"/>
    </svg>
    Volver al inicio
  </a>
</main>

<!-- Modal para editar/crear card -->
<div class="modal fade" id="cardModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content" style="background: #1a1a1a; color: #fff;">
      <div class="modal-header border-secondary">
        <h5 class="modal-title" id="cardModalTitle">Nueva Card</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="cardForm">
          <input type="hidden" id="cardId">
          
          <div class="row g-3">
            <!-- Columna izquierda: Contenido -->
            <div class="col-md-6">
              <h6 class="text-muted mb-3">Contenido</h6>
              
              <div class="mb-3">
                <label class="form-label">Título *</label>
                <input type="text" class="form-control bg-dark text-white border-secondary" id="cardTitulo" required>
              </div>
              
              <div class="mb-3">
                <label class="form-label">Subtítulo</label>
                <input type="text" class="form-control bg-dark text-white border-secondary" id="cardSubtitulo">
              </div>
              
              <div class="mb-3">
                <label class="form-label">Imagen</label>
                <div class="cm-image-upload-container">
                  <div class="cm-image-preview-box" id="imagePreviewBox">
                    <img id="imagePreviewThumb" src="" alt="Preview" style="display: none;">
                    <div class="cm-image-placeholder" id="imagePlaceholder">
                      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <rect width="18" height="18" x="3" y="3" rx="2"/>
                        <circle cx="9" cy="9" r="2"/>
                        <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
                      </svg>
                      <span>Sin imagen</span>
                    </div>
                  </div>
                  <div class="cm-image-actions">
                    <label class="btn btn-sm btn-outline-light w-100 mb-2">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                        <polyline points="17 8 12 3 7 8"/>
                        <line x1="12" y1="3" x2="12" y2="15"/>
                      </svg>
                      Subir imagen
                      <input type="file" id="cardImagenFile" accept="image/*" hidden>
                    </label>
                    <button type="button" class="btn btn-sm btn-outline-danger w-100" id="btnRemoveImage" style="display: none;">
                      Quitar imagen
                    </button>
                  </div>
                </div>
                <input type="hidden" id="cardImagen">
                <div class="cm-upload-progress" id="uploadProgress" style="display: none;">
                  <div class="progress" style="height: 4px;">
                    <div class="progress-bar bg-primary" id="uploadProgressBar" style="width: 0%"></div>
                  </div>
                  <small class="text-muted">Subiendo...</small>
                </div>
              </div>
              
              <div class="mb-3">
                <label class="form-label">Texto del botón</label>
                <input type="text" class="form-control bg-dark text-white border-secondary" id="cardTextoBoton" value="Ver colección">
              </div>
              
              <div class="mb-3">
                <label class="form-label">Filtros (query string) *</label>
                <input type="text" class="form-control bg-dark text-white border-secondary" id="cardFiltros" placeholder="categoria=buzos&genero=hombre" required>
                <small class="text-muted">Ejemplo: categoria=buzos&genero=hombre&marca=nike</small>
              </div>
            </div>
            
            <!-- Columna derecha: Estilos -->
            <div class="col-md-6">
              <h6 class="text-muted mb-3">Estilos</h6>
              
              <div class="row g-2 mb-3">
                <div class="col-6">
                  <label class="form-label">Color de fondo</label>
                  <div class="d-flex gap-2">
                    <input type="color" class="form-control form-control-color" id="cardColorFondo" value="#1a1a1a">
                    <input type="text" class="form-control bg-dark text-white border-secondary" id="cardColorFondoText" value="#1a1a1a" style="font-size: 0.85rem;">
                  </div>
                </div>
                <div class="col-6">
                  <label class="form-label">Color de texto</label>
                  <div class="d-flex gap-2">
                    <input type="color" class="form-control form-control-color" id="cardColorTexto" value="#ffffff">
                    <input type="text" class="form-control bg-dark text-white border-secondary" id="cardColorTextoText" value="#ffffff" style="font-size: 0.85rem;">
                  </div>
                </div>
              </div>
              
              <div class="row g-2 mb-3">
                <div class="col-6">
                  <label class="form-label">Color botón</label>
                  <div class="d-flex gap-2">
                    <input type="color" class="form-control form-control-color" id="cardColorBoton" value="#ffffff">
                    <input type="text" class="form-control bg-dark text-white border-secondary" id="cardColorBotonText" value="#ffffff" style="font-size: 0.85rem;">
                  </div>
                </div>
                <div class="col-6">
                  <label class="form-label">Color texto botón</label>
                  <div class="d-flex gap-2">
                    <input type="color" class="form-control form-control-color" id="cardColorBotonTexto" value="#1a1a1a">
                    <input type="text" class="form-control bg-dark text-white border-secondary" id="cardColorBotonTextoText" value="#1a1a1a" style="font-size: 0.85rem;">
                  </div>
                </div>
              </div>
              
              <div class="mb-3">
                <label class="form-label">Orden</label>
                <input type="number" class="form-control bg-dark text-white border-secondary" id="cardOrden" value="0" min="0">
              </div>
              
              <div class="form-check mb-3">
                <input type="checkbox" class="form-check-input" id="cardActivo" checked>
                <label class="form-check-label" for="cardActivo">Card activa</label>
              </div>
              
              <!-- Preview -->
              <div class="mt-4">
                <label class="form-label">Vista previa</label>
                <div id="cardPreview" class="cm-card-preview">
                  <div class="cm-card-preview-content">
                    <h3>Título</h3>
                    <span class="cm-card-preview-btn">Ver colección →</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer border-secondary">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="button" class="btn btn-danger" id="btnDeleteCard" style="display: none;">Eliminar</button>
        <button type="button" class="btn btn-primary" id="btnSaveCard">Guardar</button>
      </div>
    </div>
  </div>
</div>

<script type="module" src="/js/configurable-page.js"></script>

<%- include('../partials/footer') %>
