<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Panel Admin - CmDesign</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="/css/admin.styles.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="admin-body">
    <!-- Sidebar -->
    <aside id="adminSidebar" class="admin-sidebar">
        <div class="sidebar-header">
            <img src="/img/logo_cmdesign_white.svg" alt="CmDesign" class="sidebar-logo">
            <button id="sidebarClose" class="sidebar-close d-lg-none">
                <i class="fas fa-times"></i>
            </button>
        </div>
        
        <nav class="sidebar-nav">
            <a href="#" class="sidebar-link active" data-section="dashboard">
                <i class="fas fa-tachometer-alt"></i>
                <span>Dashboard</span>
            </a>
            <a href="#" class="sidebar-link" data-section="products">
                <i class="fas fa-box"></i>
                <span>Productos</span>
            </a>
            <a href="#" class="sidebar-link" data-section="categories">
                <i class="fas fa-tags"></i>
                <span>Categorías</span>
            </a>
            <a href="#" class="sidebar-link" data-section="users">
                <i class="fas fa-users"></i>
                <span>Usuarios</span>
            </a>
            <a href="#" class="sidebar-link" data-section="sellers">
                <i class="fas fa-user-tie"></i>
                <span>Vendedores</span>
            </a>
            <a href="#" class="sidebar-link" data-section="orders">
                <i class="fas fa-shopping-bag"></i>
                <span>Pedidos</span>
            </a>
            <a href="#" class="sidebar-link" data-section="coupons">
                <i class="fas fa-ticket-alt"></i>
                <span>Cupones</span>
            </a>
            <a href="#" class="sidebar-link" data-section="shipping">
                <i class="fas fa-truck"></i>
                <span>Zonas Envío</span>
            </a>
            <a href="#" class="sidebar-link" data-section="reports">
                <i class="fas fa-chart-bar"></i>
                <span>Reportes</span>
            </a>
        </nav>
        
        <div class="sidebar-footer">
            <a href="/" class="sidebar-link">
                <i class="fas fa-store"></i>
                <span>Ir a la tienda</span>
            </a>
            <button id="logoutBtn" class="sidebar-link logout-btn">
                <i class="fas fa-sign-out-alt"></i>
                <span>Cerrar sesión</span>
            </button>
        </div>
    </aside>
    
    <!-- Overlay para mobile -->
    <div id="sidebarOverlay" class="sidebar-overlay"></div>
    
    <!-- Main Content -->
    <main id="adminMain" class="admin-main">
        <!-- Top Bar -->
        <header class="admin-topbar">
            <button id="sidebarToggle" class="topbar-toggle">
                <i class="fas fa-bars"></i>
            </button>
            <div class="topbar-title">
                <h1 id="sectionTitle">Dashboard</h1>
            </div>
            <div class="topbar-user">
                <span id="adminEmail">Admin</span>
                <img src="/img/icon-user.svg" alt="Admin" class="topbar-avatar">
            </div>
        </header>
        
        <!-- Content Area -->
        <div class="admin-content">
            <!-- Dashboard Section -->
            <section id="section-dashboard" class="admin-section active">
                <div class="section-loading">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            </section>
            
            <!-- Products Section -->
            <section id="section-products" class="admin-section">
                <div class="section-header-bar">
                    <h2>Gestión de Productos</h2>
                    <button class="btn btn-primary-admin" data-bs-toggle="modal" data-bs-target="#productModal">
                        <i class="fas fa-plus me-2"></i>Nuevo Producto
                    </button>
                </div>
                <div id="productsContent" class="section-content">
                    <div class="section-loading">
                        <div class="spinner-border" role="status"></div>
                    </div>
                </div>
            </section>
            
            <!-- Categories Section -->
            <section id="section-categories" class="admin-section">
                <div class="section-header-bar">
                    <h2>Gestión de Categorías</h2>
                    <button class="btn btn-primary-admin" data-bs-toggle="modal" data-bs-target="#categoryModal">
                        <i class="fas fa-plus me-2"></i>Nueva Categoría
                    </button>
                </div>
                <div id="categoriesContent" class="section-content">
                    <div class="section-loading">
                        <div class="spinner-border" role="status"></div>
                    </div>
                </div>
            </section>
            
            <!-- Users Section -->
            <section id="section-users" class="admin-section">
                <div class="section-header-bar">
                    <h2>Gestión de Usuarios</h2>
                </div>
                <div id="usersContent" class="section-content">
                    <div class="section-loading">
                        <div class="spinner-border" role="status"></div>
                    </div>
                </div>
            </section>
            
            <!-- Sellers Section -->
            <section id="section-sellers" class="admin-section">
                <div class="section-header-bar">
                    <h2>Gestión de Vendedores</h2>
                    <button class="btn btn-primary-admin" id="btnAssignSeller">
                        <i class="fas fa-user-plus me-2"></i>Asignar Vendedor
                    </button>
                </div>
                <div id="sellersContent" class="section-content">
                    <div class="section-loading">
                        <div class="spinner-border" role="status"></div>
                    </div>
                </div>
            </section>
            
            <!-- Orders Section -->
            <section id="section-orders" class="admin-section">
                <div class="section-header-bar">
                    <h2>Gestión de Pedidos</h2>
                    <div class="orders-filters">
                        <select id="orderStatusFilter" class="form-select form-select-sm">
                            <option value="">Todos los estados</option>
                            <option value="borrador">Borrador</option>
                            <option value="confirmado">Confirmado</option>
                            <option value="pagado">Pagado</option>
                            <option value="en_preparacion">En preparación</option>
                            <option value="enviado">Enviado</option>
                            <option value="entregado">Entregado</option>
                            <option value="cancelado">Cancelado</option>
                        </select>
                    </div>
                </div>
                <div id="ordersContent" class="section-content">
                    <div class="section-loading">
                        <div class="spinner-border" role="status"></div>
                    </div>
                </div>
            </section>
            
            <!-- Coupons Section -->
            <section id="section-coupons" class="admin-section">
                <div class="section-header-bar">
                    <h2>Gestión de Cupones</h2>
                    <button class="btn btn-primary-admin" data-bs-toggle="modal" data-bs-target="#couponModal">
                        <i class="fas fa-plus me-2"></i>Nuevo Cupón
                    </button>
                </div>
                <div id="couponsContent" class="section-content">
                    <div class="section-loading">
                        <div class="spinner-border" role="status"></div>
                    </div>
                </div>
            </section>
            
            <!-- Shipping Zones Section -->
            <section id="section-shipping" class="admin-section">
                <div class="section-header-bar">
                    <h2>Zonas de Envío</h2>
                    <button class="btn btn-primary-admin" data-bs-toggle="modal" data-bs-target="#shippingModal">
                        <i class="fas fa-plus me-2"></i>Nueva Zona
                    </button>
                </div>
                <div id="shippingContent" class="section-content">
                    <div class="section-loading">
                        <div class="spinner-border" role="status"></div>
                    </div>
                </div>
            </section>
            
            <!-- Reports Section -->
            <section id="section-reports" class="admin-section">
                <div class="section-header-bar">
                    <h2>Reportes y Estadísticas</h2>
                    <div class="reports-filters">
                        <input type="date" id="reportDateFrom" class="form-control form-control-sm">
                        <input type="date" id="reportDateTo" class="form-control form-control-sm">
                        <button id="btnGenerateReport" class="btn btn-primary-admin btn-sm">
                            <i class="fas fa-sync me-1"></i>Generar
                        </button>
                    </div>
                </div>
                <div id="reportsContent" class="section-content">
                    <div class="section-loading">
                        <div class="spinner-border" role="status"></div>
                    </div>
                </div>
            </section>
        </div>
    </main>
    
    <!-- Modal: Producto (Estilo PDP) -->
    <div class="modal fade" id="productModal" tabindex="-1">
        <div class="modal-dialog modal-fullscreen">
            <div class="modal-content admin-modal pdp-form-modal">
                <div class="modal-header pdp-form-header">
                    <h5 class="modal-title" id="productModalTitle">Nuevo Producto</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-0">
                    <form id="productForm">
                        <input type="hidden" id="productId">
                        
                        <div class="pdp-form-container">
                            <!-- COLUMNA IZQUIERDA: Galería Preview -->
                            <section class="pdp-form-gallery">
                                <!-- Badge de descuento (calculado) -->
                                <div class="pdp-form-badge" id="previewBadge" style="display:none;">
                                    <span id="previewDiscountText">-0%</span>
                                </div>
                                
                                <!-- Imagen Principal Preview -->
                                <div class="pdp-form-main-image">
                                    <img id="previewMainImage" src="https://placehold.co/600x700/2d2d2d/666?text=Subir+Imagen" alt="Preview">
                                    <!-- Navegación -->
                                    <button type="button" class="pdp-form-nav-btn pdp-form-nav-prev" id="previewPrevBtn">
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
                                    </button>
                                    <button type="button" class="pdp-form-nav-btn pdp-form-nav-next" id="previewNextBtn">
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
                                    </button>
                                </div>
                                
                                <!-- Thumbnails -->
                                <div class="pdp-form-thumbnails" id="previewThumbnails">
                                    <div class="pdp-form-thumb pdp-form-thumb-add" id="addImageBtn">
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
                                        </svg>
                                    </div>
                                </div>
                                <input type="file" class="d-none" id="productImages" accept="image/*" multiple>
                                
                                <!-- Ficha Técnica -->
                                <div class="pdp-form-tech-sheet">
                                    <label class="pdp-form-tech-label">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                            <polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>
                                        </svg>
                                        <span id="techSheetName">Subir ficha técnica (PDF)</span>
                                        <input type="file" class="d-none" id="productTechSheet" accept="application/pdf">
                                    </label>
                                </div>
                            </section>

                            <!-- COLUMNA DERECHA: Info del Producto -->
                            <section class="pdp-form-info">
                                <!-- Marca -->
                                <div class="pdp-form-brand-row">
                                    <select class="pdp-form-brand-select" id="productBrand">
                                        <option value="">SELECCIONAR MARCA</option>
                                    </select>
                                </div>
                                
                                <!-- Nombre -->
                                <input type="text" class="pdp-form-title" id="productName" placeholder="NOMBRE DEL PRODUCTO *" required>
                                
                                <!-- SKU -->
                                <div class="pdp-form-sku">
                                    <span>Ref:</span>
                                    <input type="text" id="productSku" placeholder="Auto-generado">
                                </div>
                                
                                <!-- Precios -->
                                <div class="pdp-form-prices">
                                    <div class="pdp-form-price-group">
                                        <label>Precio Original</label>
                                        <input type="number" class="pdp-form-price-original" id="productOriginalPrice" min="0" step="100" placeholder="$0">
                                    </div>
                                    <div class="pdp-form-price-group">
                                        <label>Precio Actual *</label>
                                        <input type="number" class="pdp-form-price-current" id="productPrice" min="0" step="100" placeholder="$0" required>
                                    </div>
                                    <div class="pdp-form-discount-badge" id="previewDiscountBadge" style="display:none;">
                                        <span id="previewDiscountPercent">-0%</span>
                                    </div>
                                </div>
                                
                                <!-- Selector de Talla/Variante -->
                                <div class="pdp-form-variants">
                                    <p class="pdp-form-variants-label">Tallas disponibles:</p>
                                    <div class="pdp-form-variants-grid" id="productSizesGrid">
                                        <!-- Se llena dinámicamente -->
                                    </div>
                                </div>
                                
                                <!-- Stock y Disponibilidad -->
                                <div class="pdp-form-stock-row">
                                    <div class="pdp-form-stock-group">
                                        <label>Stock</label>
                                        <input type="number" id="productStock" min="0" value="0">
                                    </div>
                                    <div class="pdp-form-stock-group">
                                        <label>Inventario</label>
                                        <select id="productInventoryType">
                                            <option value="stock">Con stock</option>
                                            <option value="pedido">Bajo pedido</option>
                                        </select>
                                    </div>
                                    <div class="pdp-form-stock-group">
                                        <label>Estado</label>
                                        <select id="productAvailability">
                                            <option value="true">Disponible</option>
                                            <option value="false">No disponible</option>
                                        </select>
                                    </div>
                                </div>
                                
                                <!-- Categorización (Acordeón estilo PDP) -->
                                <div class="pdp-form-accordion">
                                    <details open>
                                        <summary>Descripción del producto *</summary>
                                        <div class="pdp-form-accordion-content">
                                            <textarea id="productDescription" rows="4" placeholder="Describe el producto..." required></textarea>
                                        </div>
                                    </details>
                                    
                                    <details>
                                        <summary>Categorización</summary>
                                        <div class="pdp-form-accordion-content">
                                            <div class="pdp-form-cat-grid">
                                                <div class="pdp-form-cat-item">
                                                    <label>Categoría</label>
                                                    <select id="productCategory">
                                                        <option value="">Seleccionar...</option>
                                                    </select>
                                                </div>
                                                <div class="pdp-form-cat-item">
                                                    <label>Subcategoría</label>
                                                    <select id="productSubcategory" disabled>
                                                        <option value="">Primero categoría</option>
                                                    </select>
                                                </div>
                                                <div class="pdp-form-cat-item">
                                                    <label>Colección</label>
                                                    <select id="productCollection">
                                                        <option value="">Seleccionar...</option>
                                                    </select>
                                                </div>
                                                <div class="pdp-form-cat-item">
                                                    <label>Personaje</label>
                                                    <select id="productCharacter">
                                                        <option value="">Seleccionar...</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                    </details>
                                    
                                    <details>
                                        <summary>Público objetivo</summary>
                                        <div class="pdp-form-accordion-content">
                                            <div class="pdp-form-cat-grid">
                                                <div class="pdp-form-cat-item">
                                                    <label>Edad</label>
                                                    <select id="productAge">
                                                        <option value="">Seleccionar...</option>
                                                    </select>
                                                </div>
                                                <div class="pdp-form-cat-item">
                                                    <label>Género</label>
                                                    <select id="productGender">
                                                        <option value="">Seleccionar...</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                    </details>
                                    
                                    <details>
                                        <summary>SEO y Etiquetas</summary>
                                        <div class="pdp-form-accordion-content">
                                            <input type="text" id="productTags" placeholder="urbano, streetwear, casual (separadas por coma)">
                                        </div>
                                    </details>
                                </div>
                                
                                <!-- Botones de acción -->
                                <div class="pdp-form-actions">
                                    <button type="button" class="pdp-form-btn-cancel" data-bs-dismiss="modal">Cancelar</button>
                                    <button type="submit" class="pdp-form-btn-save">GUARDAR PRODUCTO</button>
                                </div>
                            </section>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Modal: Categoría -->
    <div class="modal fade" id="categoryModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content admin-modal">
                <div class="modal-header">
                    <h5 class="modal-title" id="categoryModalTitle">Nueva Categoría</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="categoryForm">
                        <input type="hidden" id="categoryId">
                        <div class="mb-3">
                            <label class="form-label">Nombre</label>
                            <input type="text" class="form-control" id="categoryName" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Tipo</label>
                            <select class="form-select" id="categoryType" required>
                                <option value="categoria">Categoría</option>
                                <option value="subcategoria">Subcategoría</option>
                                <option value="genero">Género</option>
                                <option value="edad">Edad</option>
                                <option value="marca">Marca</option>
                                <option value="personaje">Personaje</option>
                                <option value="coleccion">Colección</option>
                                <option value="talla">Talla</option>
                            </select>
                        </div>
                        <div class="mb-3" id="categoryParentGroup" style="display: none;">
                            <label class="form-label">Categoría Padre</label>
                            <select class="form-select" id="categoryParent">
                                <option value="">Seleccionar categoría padre...</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Descripción</label>
                            <textarea class="form-control" id="categoryDescription" rows="2"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Orden</label>
                            <input type="number" class="form-control" id="categoryOrder" min="0" value="0">
                        </div>
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" id="categoryActive" checked>
                            <label class="form-check-label" for="categoryActive">Activa</label>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" form="categoryForm" class="btn btn-primary-admin">Guardar</button>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Modal: Cupón -->
    <div class="modal fade" id="couponModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content admin-modal">
                <div class="modal-header">
                    <h5 class="modal-title" id="couponModalTitle">Nuevo Cupón</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="couponForm">
                        <input type="hidden" id="couponId">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">Código</label>
                                <input type="text" class="form-control text-uppercase" id="couponCode" required maxlength="20" placeholder="DESCUENTO20">
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">Nombre</label>
                                <input type="text" class="form-control" id="couponName" required placeholder="Descuento de bienvenida">
                            </div>
                            <div class="col-12">
                                <label class="form-label">Descripción</label>
                                <textarea class="form-control" id="couponDescription" rows="2" required></textarea>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Tipo</label>
                                <select class="form-select" id="couponType" required>
                                    <option value="porcentaje">Porcentaje</option>
                                    <option value="fijo">Monto Fijo</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Valor</label>
                                <input type="number" class="form-control" id="couponValue" min="0" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Descuento Máximo</label>
                                <input type="number" class="form-control" id="couponMaxDiscount" min="0" placeholder="Solo para %">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Monto Mínimo</label>
                                <input type="number" class="form-control" id="couponMinAmount" min="0" value="0">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Máx. Usos Total</label>
                                <input type="number" class="form-control" id="couponMaxUses" min="1" placeholder="Ilimitado">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Máx. Usos/Usuario</label>
                                <input type="number" class="form-control" id="couponMaxUsesPerUser" min="1" value="1">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Fecha Inicio</label>
                                <input type="datetime-local" class="form-control" id="couponStartDate" required>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Fecha Vencimiento</label>
                                <input type="datetime-local" class="form-control" id="couponEndDate" required>
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" id="couponActive" checked>
                                    <label class="form-check-label" for="couponActive">Activo</label>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" form="couponForm" class="btn btn-primary-admin">Guardar</button>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Modal: Zona de Envío -->
    <div class="modal fade" id="shippingModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content admin-modal">
                <div class="modal-header">
                    <h5 class="modal-title" id="shippingModalTitle">Nueva Zona de Envío</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="shippingForm">
                        <input type="hidden" id="shippingId">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Nombre</label>
                                <input type="text" class="form-control" id="shippingName" required placeholder="Norte Medellín">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Código</label>
                                <input type="text" class="form-control text-uppercase" id="shippingCode" required placeholder="NORTE_MED">
                            </div>
                            <div class="col-12">
                                <label class="form-label">Descripción</label>
                                <textarea class="form-control" id="shippingDescription" rows="2"></textarea>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Tarifa Base</label>
                                <input type="number" class="form-control" id="shippingBaseRate" min="0" required>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Tarifa por Kg</label>
                                <input type="number" class="form-control" id="shippingKgRate" min="0" value="0">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Tiempo Entrega (días)</label>
                                <input type="text" class="form-control" id="shippingDeliveryTime" placeholder="1-3">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Barrios (separados por coma)</label>
                                <textarea class="form-control" id="shippingBarrios" rows="2" placeholder="Laureles, El Poblado, Envigado"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Envío Gratis desde ($)</label>
                                <input type="number" class="form-control" id="shippingFreeFrom" min="0" placeholder="Sin mínimo">
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" id="shippingActive" checked>
                                    <label class="form-check-label" for="shippingActive">Activa</label>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" form="shippingForm" class="btn btn-primary-admin">Guardar</button>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Modal: Cambiar Rol -->
    <div class="modal fade" id="roleModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content admin-modal">
                <div class="modal-header">
                    <h5 class="modal-title">Cambiar Rol</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Cambiar rol de <strong id="roleUserName"></strong></p>
                    <input type="hidden" id="roleUserId">
                    <select class="form-select" id="roleSelect">
                        <option value="client">Cliente</option>
                        <option value="seller">Vendedor</option>
                        <option value="admin">Administrador</option>
                    </select>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-warning" id="btnConfirmRole">Cambiar</button>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Modal: Comisión Vendedor -->
    <div class="modal fade" id="commissionModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content admin-modal">
                <div class="modal-header">
                    <h5 class="modal-title">Ajustar Comisión</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Vendedor: <strong id="commissionSellerName"></strong></p>
                    <input type="hidden" id="commissionSellerId">
                    <div class="mb-3">
                        <label class="form-label">Porcentaje de Comisión (%)</label>
                        <input type="number" class="form-control" id="commissionPercent" min="0" max="100" step="0.5">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Meta Mensual ($)</label>
                        <input type="number" class="form-control" id="commissionGoal" min="0">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-primary-admin" id="btnSaveCommission">Guardar</button>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Modal: Detalle Pedido -->
    <div class="modal fade" id="orderModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content admin-modal">
                <div class="modal-header">
                    <h5 class="modal-title">Detalle del Pedido <span id="orderNumber"></span></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" id="orderDetailContent">
                    <div class="section-loading">
                        <div class="spinner-border" role="status"></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <select class="form-select w-auto" id="orderStatusChange">
                        <option value="">Cambiar estado...</option>
                        <option value="confirmado">Confirmado</option>
                        <option value="pagado">Pagado</option>
                        <option value="en_preparacion">En preparación</option>
                        <option value="enviado">Enviado</option>
                        <option value="entregado">Entregado</option>
                        <option value="cancelado">Cancelado</option>
                    </select>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Modal: Confirmar Eliminación -->
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content admin-modal">
                <div class="modal-header bg-danger">
                    <h5 class="modal-title text-white">Confirmar Eliminación</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p id="deleteMessage">¿Estás seguro de que deseas eliminar este elemento?</p>
                    <input type="hidden" id="deleteItemId">
                    <input type="hidden" id="deleteItemType">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-danger" id="btnConfirmDelete">Eliminar</button>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Toast Container -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="adminToast" class="toast" role="alert">
            <div class="toast-header">
                <i id="toastIcon" class="fas fa-check-circle text-success me-2"></i>
                <strong class="me-auto" id="toastTitle">Éxito</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
            </div>
            <div class="toast-body" id="toastMessage"></div>
        </div>
    </div>

    <script>
        window.BACKEND_URL = '<%= typeof BACKEND_URL !== "undefined" ? BACKEND_URL : "" %>';
    </script>
    <script type="module" src="/js/api.functions.js"></script>
    <script type="module" src="/js/admin.functions.js"></script>
</body>
</html>